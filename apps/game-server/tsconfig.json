{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "composite": false,
    "baseUrl": ".",
    "paths": {
      "@rift/shared": ["../../packages/shared/src/index.ts"],
      "@rift/shared/*": ["../../packages/shared/src/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*"]
}