{
  "name": "@rift/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@colyseus/core": "0.15.0",
    "@colyseus/ws-transport": "0.15.0",
    "@rift/shared": "*",
    "express": "4.21.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.7.5",
    "@types/ws": "8.5.12",
    "tsx": "4.19.1",
    "typescript": "5.6.3"
  }
}